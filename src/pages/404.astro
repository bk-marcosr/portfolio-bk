---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Página não encontrada — Marcos Gabriel">
  <section class="mx-auto flex min-h-[60dvh] max-w-6xl flex-col justify-center px-5 py-24 sm:px-8">
    <p class="font-mono text-xs text-subtle">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-fg md:text-5xl">Essa rota não existe.</h1>
    <a href={url('/')} class="link mt-8 w-fit text-sm">Voltar para o início</a>
  </section>
</Base>
