---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { featuredProjects } from '../../data/projects';
import type { FeaturedProject } from '../../data/types';
import { url } from '../../lib/url';

export const getStaticPaths = (() =>
  featuredProjects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      next: featuredProjects[(index + 1) % featuredProjects.length],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  project: FeaturedProject;
  next: FeaturedProject;
}

const { project, next } = Astro.props;

const meta = [
  { label: 'Papel', value: project.role },
  { label: 'Período', value: project.period },
  { label: 'Status', value: project.statusLabel },
];
---

<Base title={`${project.name} — estudo de caso · Marcos Gabriel`} description={project.summary} type="article">
  <article class="mx-auto max-w-6xl px-5 pb-24 pt-12 sm:px-8 md:pt-16">
    <a href={url('/#projetos')} class="inline-flex items-center gap-2 font-mono text-xs text-subtle transition-colors hover:text-fg">
      <span aria-hidden="true">←</span> projetos
    </a>

    <header class="mt-10 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <StatusBadge status={project.status} label={project.statusLabel} />
        <h1 class="mt-6 text-balance text-4xl font-semibold tracking-[-0.03em] text-fg md:text-6xl">{project.name}</h1>
        {project.formerName && <p class="mt-2 font-mono text-xs text-faint">antes {project.formerName}</p>}
        <p class="mt-5 max-w-2xl text-pretty text-xl leading-relaxed text-muted">{project.tagline}</p>
      </div>
      <dl class="self-end border-t border-line lg:col-span-4">
        {
          meta.map((item) => (
            <div class="grid grid-cols-[5.5rem_1fr] gap-4 border-b border-line py-3 text-sm">
              <dt class="font-mono text-xs leading-5 text-subtle">{item.label}</dt>
              <dd class="leading-5 text-fg/90">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class:list={['mt-14', project.visual.kind === 'flow' && 'mx-auto max-w-3xl']}>
      <ProjectVisual visual={project.visual} mode="gallery" eager />
    </div>

    <div class="mt-16 grid gap-12 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-24">
          <div class="rule"></div>
          <p class="pt-5 font-mono text-xs uppercase tracking-[0.16em] text-subtle">Resumo</p>
          <p class="mt-4 text-[15px] leading-relaxed text-muted">{project.summary}</p>
          <ul class="mt-6 space-y-2 border-t border-line pt-5">
            {
              project.facts.map((fact) => (
                <li class="flex items-center gap-2.5 font-mono text-xs text-fg/90">
                  <span class="font-mono text-signal" aria-hidden="true">–</span>
                  {fact}
                </li>
              ))
            }
          </ul>
          <p class="mt-6 border-t border-line pt-5 font-mono text-[11px] leading-relaxed text-faint">
            {project.stack.join(' · ')}
          </p>
        </div>
      </aside>

      <div class="space-y-14 lg:col-span-8">
        {
          project.sections.map((section) => (
            <section>
              <h2 class="text-2xl font-semibold tracking-tight text-fg">{section.title}</h2>
              {section.body?.map((paragraph) => (
                <p class="mt-4 text-pretty text-[17px] leading-[1.75] text-muted">{paragraph}</p>
              ))}
              {section.bullets && (
                <ul class="mt-5 space-y-3">
                  {section.bullets.map((bullet) => (
                    <li class="grid grid-cols-[1rem_1fr] gap-3 text-[17px] leading-[1.7] text-muted">
                      <span class="font-mono text-signal" aria-hidden="true">–</span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }

        <p class="rounded-lg border border-line bg-surface px-5 py-4 text-sm leading-relaxed text-muted">
          Código-fonte privado. Faço um walkthrough técnico do projeto em call —{' '}
          <a href={url('/#contato')} class="link">fale comigo</a>.
        </p>
      </div>
    </div>

    <nav aria-label="Próximo projeto" class="mt-24">
      <div class="rule"></div>
      <a href={url(`/projetos/${next.slug}/`)} class="group flex items-end justify-between gap-6 pt-6">
        <span>
          <span class="font-mono text-xs uppercase tracking-[0.16em] text-subtle">Próximo projeto</span>
          <span class="mt-3 block text-3xl font-semibold tracking-tight text-fg transition-colors group-hover:text-signal md:text-4xl">
            {next.name}
          </span>
        </span>
        <span class="pb-1 text-2xl text-subtle transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </nav>
  </article>
</Base>
