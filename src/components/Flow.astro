---
import type { Flow } from '../data/types';

interface Props {
  flow: Flow;
  compact?: boolean;
}

const { flow, compact = false } = Astro.props;

/** Centro horizontal (0–100) de cada coluna de uma camada com `count` nós. */
const centers = (count: number): number[] =>
  Array.from({ length: count }, (_, i) => ((i + 0.5) * 100) / count);

interface Connector {
  from: number[];
  to: number[];
  minX: number;
  maxX: number;
}

const connectors: Connector[] = flow.layers.slice(1).map((layer, i) => {
  const from = centers(flow.layers[i].length);
  const to = centers(layer.length);
  const all = [...from, ...to];
  return { from, to, minX: Math.min(...all), maxX: Math.max(...all) };
});
---

<figure class="overflow-hidden rounded-xl border border-line bg-surface">
  <div class="flex items-center justify-between gap-4 border-b border-line px-4 py-3">
    <span class="truncate font-mono text-[11px] text-subtle">{flow.title}</span>
    <span class="flex shrink-0 gap-1" aria-hidden="true">
      <span class="size-1.5 rounded-full bg-line-strong"></span>
      <span class="size-1.5 rounded-full bg-line-strong"></span>
      <span class="size-1.5 rounded-full bg-line-strong"></span>
    </span>
  </div>

  <div class:list={['px-4 sm:px-6', compact ? 'py-5' : 'py-7']} role="img" aria-label={`Diagrama: ${flow.title}`}>
    {
      flow.layers.map((layer, layerIndex) => (
        <>
          {layerIndex > 0 && (
            <svg class="block h-6 w-full" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true">
              {connectors[layerIndex - 1].from.map((x) => (
                <line x1={x} y1="0" x2={x} y2="12" class="stroke-signal" stroke-width="1" vector-effect="non-scaling-stroke" />
              ))}
              {connectors[layerIndex - 1].maxX > connectors[layerIndex - 1].minX && (
                <line
                  x1={connectors[layerIndex - 1].minX}
                  y1="12"
                  x2={connectors[layerIndex - 1].maxX}
                  y2="12"
                  class="stroke-signal"
                  stroke-width="1"
                  vector-effect="non-scaling-stroke"
                />
              )}
              {connectors[layerIndex - 1].to.map((x) => (
                <line x1={x} y1="12" x2={x} y2="24" class="stroke-signal" stroke-width="1" vector-effect="non-scaling-stroke" />
              ))}
            </svg>
          )}
          <div class="grid gap-3" style={`grid-template-columns: repeat(${layer.length}, minmax(0, 1fr));`}>
            {layer.map((node) => (
              <div class="min-w-0 rounded-lg border border-line-strong bg-raised px-3 py-2.5 text-center">
                <div class="flex items-center justify-center gap-2 text-[13px] font-medium text-fg">
                  {node.live && <span class="size-1.5 shrink-0 rounded-full bg-live" aria-hidden="true" />}
                  <span class="truncate">{node.label}</span>
                </div>
                {node.meta && <div class="mt-1 font-mono text-[10.5px] leading-snug text-subtle">{node.meta}</div>}
              </div>
            ))}
          </div>
        </>
      ))
    }
  </div>

  {flow.caption && <figcaption class="border-t border-line px-4 py-3 text-xs leading-relaxed text-subtle">{flow.caption}</figcaption>}
</figure>
