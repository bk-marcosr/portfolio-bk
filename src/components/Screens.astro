---
import { Image } from 'astro:assets';
import type { Screenshot } from '../data/types';

interface Props {
  screens: Screenshot[];
  caption: string;
  /** Na home mostramos só a tela principal; no estudo de caso, todas. */
  mode?: 'single' | 'gallery';
  eager?: boolean;
}

const { screens, caption, mode = 'single', eager = false } = Astro.props;
const [primary, ...rest] = screens;
---

<figure>
  <div class="overflow-hidden rounded-xl border border-line bg-surface">
    <Image
      src={primary.src}
      alt={primary.alt}
      widths={[640, 960, 1280, 1920]}
      sizes="(min-width: 1024px) 680px, 100vw"
      format="webp"
      quality={82}
      loading={eager ? 'eager' : 'lazy'}
      class="block h-auto w-full"
    />
  </div>

  {
    mode === 'gallery' && rest.length > 0 && (
      <div class="mt-3 grid grid-cols-2 gap-3">
        {rest.map((screen) => (
          <div class="overflow-hidden rounded-lg border border-line bg-surface">
            <Image
              src={screen.src}
              alt={screen.alt}
              widths={[480, 960]}
              sizes="(min-width: 1024px) 340px, 50vw"
              format="webp"
              quality={80}
              loading="lazy"
              class="block h-auto w-full"
            />
          </div>
        ))}
      </div>
    )
  }

  <figcaption class="mt-3 font-mono text-[11px] text-subtle">{caption}</figcaption>
</figure>
