---
import type { ProjectStatus } from '../data/types';
import { STATUS_TONE } from '../data/projects';

interface Props {
  status: ProjectStatus;
  label: string;
}

const { status, label } = Astro.props;
const tone = STATUS_TONE[status];

const dotClass = {
  live: 'bg-live',
  signal: 'bg-signal',
  neutral: 'bg-subtle',
}[tone];
---

<span class="inline-flex items-center gap-2 rounded-full border border-line px-2.5 py-1 font-mono text-[11px] leading-none text-muted">
  <span class:list={['size-1.5 shrink-0 rounded-full', dotClass]} aria-hidden="true"></span>
  {label}
</span>
