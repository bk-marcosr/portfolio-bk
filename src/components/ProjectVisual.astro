---
import type { ProjectVisual } from '../data/types';
import Flow from './Flow.astro';
import Screens from './Screens.astro';

interface Props {
  visual: ProjectVisual;
  mode?: 'single' | 'gallery';
  eager?: boolean;
}

const { visual, mode = 'single', eager = false } = Astro.props;
---

{visual.kind === 'flow' && <Flow flow={visual.flow} />}
{visual.kind === 'screens' && <Screens screens={visual.screens} caption={visual.caption} mode={mode} eager={eager} />}
