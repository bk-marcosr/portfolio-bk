---
import { Image } from 'astro:assets';
import type { FeaturedProject } from '../data/types';
import { url } from '../lib/url';

interface Props {
  project: FeaturedProject;
}

const { project } = Astro.props;
const caseUrl = url(`/projetos/${project.slug}/`);
const media = project.media;
const sideScreens = project.screens ? (media ? project.screens.items.slice(1) : project.screens.items) : [];
---

<section id={project.slug} class="px-5 py-24 sm:px-10 sm:py-36" style={`--c: ${project.color}`} data-chapter data-cursor-color={project.color}>
  <div class="mx-auto max-w-[1400px]">
    <div class="h-[6px] w-full origin-left bg-[var(--c)]" data-bar></div>

    <div class="mt-8 flex flex-wrap items-end justify-between gap-x-10 gap-y-3">
      <h2 class="font-display text-[clamp(3rem,11vw,10rem)] font-semibold leading-[0.88] tracking-[-0.045em]" data-split="chapter">
        {project.name}
      </h2>
      {project.formerName && <p class="pb-2 text-[15px] text-faint">antes {project.formerName}</p>}
    </div>

    {
      media && (
        <figure class="mt-12 lg:mt-16">
          <div class:list={['grid items-end gap-4', media.phone && 'lg:grid-cols-[1fr_auto]']}>
            <div class="overflow-hidden rounded-md bg-ink-2" data-reveal="clip">
              {media.kind === 'video' ? (
                <video
                  class="block h-auto w-full"
                  src={url(media.src)}
                  poster={url(media.poster)}
                  width={media.width}
                  height={media.height}
                  muted
                  loop
                  playsinline
                  preload="none"
                  data-autoplay
                  aria-label={media.label}
                />
              ) : (
                <Image
                  src={media.image.src}
                  alt={media.image.alt}
                  widths={[640, 960, 1280, 1920]}
                  sizes="(min-width: 1400px) 1320px, 100vw"
                  format="webp"
                  quality={86}
                  class="block h-auto w-full"
                />
              )}
            </div>
            {media.phone && (
              <div class="hidden w-[15.5rem] overflow-hidden rounded-[1.4rem] border-[6px] border-ink-2 lg:block" data-reveal="clip">
                <Image src={media.phone.src} alt={media.phone.alt} widths={[260, 520]} sizes="248px" format="webp" quality={86} class="block h-auto w-full" />
              </div>
            )}
          </div>
          <figcaption class="mt-4 text-[14px] text-faint">{media.label}</figcaption>
        </figure>
      )
    }

    <div class="mt-14 grid gap-14 lg:mt-20 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5" data-reveal="up">
        <p class="font-display text-[clamp(1.3rem,2.1vw,1.7rem)] font-medium leading-[1.25] tracking-[-0.01em]">{project.line}</p>
        <p class="mt-6 max-w-[34rem] text-[17px] leading-[1.7] text-mute">{project.lead}</p>

        <ul class="mt-10 space-y-4">
          {
            project.facts.map((fact) => (
              <li class="grid grid-cols-[1.25rem_1fr] text-[16px] leading-[1.6] text-paper/90">
                <span class="mt-[0.55em] block size-[7px] bg-[var(--c)]" aria-hidden="true" />
                <span>{fact}</span>
              </li>
            ))
          }
        </ul>

        <p class="mt-10 text-[14px] leading-relaxed text-faint">{project.stack.join(', ')}</p>
        <a href={caseUrl} class="tlink mt-8 inline-block font-display text-[17px] font-medium">Ler o caso completo</a>
      </div>

      <div class="lg:col-span-7">
        {
          project.sim && (
            <div data-sim-block data-lane={project.lane}>
              <dl class="flex flex-wrap gap-x-10 gap-y-4">
                {project.sim.counters.map((counter) => (
                  <div data-counter={counter.field}>
                    <dt class="sr-only">{counter.label}</dt>
                    <dd class="flex items-baseline gap-2.5">
                      <span class="font-display text-[clamp(2.4rem,4.5vw,3.6rem)] font-semibold leading-none tracking-[-0.03em] text-[var(--c)] tabular-nums" data-value>
                        0
                      </span>
                      <span class="text-[15px] text-mute">{counter.label}</span>
                    </dd>
                  </div>
                ))}
              </dl>

              <canvas
                class="mt-6 block h-[180px] w-full sm:h-[210px]"
                data-sim="detail"
                data-lane={project.lane}
                role="img"
                aria-label={`Simulação do ${project.name}. ${project.sim.caption}`}
              />

              <div class="mt-4 flex flex-wrap gap-x-8 gap-y-3">
                {project.sim.actions.map((action) => (
                  <button
                    type="button"
                    class="sim-action"
                    data-action={action.kind}
                    data-amount={action.kind === 'burst' ? action.amount : undefined}
                    data-label={action.label}
                    data-label-active={action.kind === 'toggle-down' ? action.labelActive : undefined}
                    aria-pressed={action.kind === 'toggle-down' ? 'false' : undefined}
                  >
                    {action.label}
                  </button>
                ))}
              </div>
              <p class="mt-6 max-w-[38rem] text-[14px] leading-relaxed text-faint">{project.sim.caption}</p>
              <p class="sr-only" aria-live="polite" data-live />
            </div>
          )
        }

        {
          !project.sim && sideScreens.length > 0 && (
            <div class="grid gap-4">
              {sideScreens.map((screen) => (
                <div class="overflow-hidden rounded-md" data-reveal="clip">
                  <Image src={screen.src} alt={screen.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 760px, 100vw" format="webp" quality={84} class="block h-auto w-full" />
                </div>
              ))}
              {project.screens && <p class="text-[14px] text-faint">{project.screens.caption}</p>}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
