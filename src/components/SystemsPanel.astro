---
import { url } from '../lib/url';

type Tone = 'live' | 'signal' | 'neutral';

interface SystemRow {
  name: string;
  state: string;
  detail: string;
  tone: Tone;
  href?: string;
}

const rows: SystemRow[] = [
  { name: 'campanhas-platform', state: 'produção', detail: 'desde jul/2026', tone: 'live', href: url('/projetos/campanhas-platform/') },
  { name: 'rotor', state: 'operação', detail: 'ciclo de 1 min', tone: 'live', href: url('/projetos/rotor/') },
  { name: 'automação rr', state: 'execução', detail: 'CRM → KPI', tone: 'live' },
  { name: 'prazinho', state: 'ativo', detail: 'rebrand out/2026', tone: 'signal', href: url('/projetos/prazinho/') },
  { name: 'rigor', state: 'acadêmico', detail: 'CVM 2010–2025', tone: 'neutral', href: url('/projetos/rigor/') },
];

const dot: Record<Tone, string> = {
  live: 'bg-live',
  signal: 'bg-signal',
  neutral: 'bg-subtle',
};

const stateColor: Record<Tone, string> = {
  live: 'text-live',
  signal: 'text-signal',
  neutral: 'text-subtle',
};
---

<section aria-label="Sistemas e status" class="overflow-hidden rounded-xl border border-line bg-surface">
  <div class="flex items-center justify-between border-b border-line px-4 py-3 font-mono text-[11px] text-subtle">
    <span>sistemas</span>
    <span>status</span>
  </div>
  <ul class="divide-y divide-line">
    {
      rows.map((row) => {
        const content = (
          <>
            <span class="flex min-w-0 items-center gap-2.5">
              <span class:list={['size-1.5 shrink-0 rounded-full', dot[row.tone]]} aria-hidden="true" />
              <span class="truncate text-fg">{row.name}</span>
            </span>
            <span class:list={['text-right', stateColor[row.tone]]}>{row.state}</span>
            <span class="hidden text-right text-faint sm:block">{row.detail}</span>
          </>
        );
        return (
          <li>
            {row.href ? (
              <a
                href={row.href}
                class="grid grid-cols-[1fr_auto] items-center gap-4 px-4 py-3 font-mono text-xs transition-colors hover:bg-raised sm:grid-cols-[1fr_5.5rem_7.5rem]"
              >
                {content}
              </a>
            ) : (
              <div class="grid grid-cols-[1fr_auto] items-center gap-4 px-4 py-3 font-mono text-xs sm:grid-cols-[1fr_5.5rem_7.5rem]">
                {content}
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
  <p class="border-t border-line px-4 py-3 font-mono text-[10.5px] leading-relaxed text-faint">
    status declarado nos próprios repositórios
  </p>
</section>
