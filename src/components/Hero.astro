---
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import { COLORS } from '../scripts/sim/lanes';
import portrait from '../assets/perfil.png';

// Os quadrados entre as repetições do nome passam pelas cores dos projetos.
const separators = [COLORS.rotor, COLORS.prazinho, COLORS.talos, COLORS.rigor, COLORS.rr];
---

<section class="relative h-[100svh] min-h-[620px] overflow-hidden" aria-labelledby="hero-title">
  <h1 id="hero-title" class="sr-only">{profile.name}, {profile.role.toLowerCase()} em {profile.location}</h1>

  <!-- Retrato recortado, ancorado no rodapé -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 flex justify-center" data-hero-portrait>
    <Image
      src={portrait}
      alt={`Foto de ${profile.name}`}
      widths={[408]}
      sizes="(min-width: 1024px) 42vh, 70vw"
      format="webp"
      quality={90}
      loading="eager"
      fetchpriority="high"
      class="h-[min(68svh,46rem)] w-auto max-w-none object-contain object-bottom [mask-image:linear-gradient(to_right,transparent,#000_18%,#000_82%,transparent),linear-gradient(to_top,transparent,#000_22%)] [mask-composite:intersect] [-webkit-mask-composite:source-in]"
    />
  </div>

  <!-- Topo: onde estou e o que faço -->
  <div class="relative mx-auto flex max-w-[1400px] items-start justify-between gap-6 px-5 pt-24 sm:px-10 sm:pt-28">
    <div class="flex items-center gap-3" data-reveal="fade">
      <span class="relative grid size-11 place-items-center rounded-full bg-paper text-ink" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="size-6 animate-[spin_12s_linear_infinite] motion-reduce:animate-none" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3c2.6 2.8 3.9 5.8 3.9 9s-1.3 6.2-3.9 9c-2.6-2.8-3.9-5.8-3.9-9s1.3-6.2 3.9-9z" />
        </svg>
      </span>
      <p class="font-display text-[15px] leading-tight">
        Belém, Pará<br /><span class="text-mute tabular-nums" data-clock>Brasil · UTC−3</span>
      </p>
    </div>

    <div class="text-right" data-reveal="fade">
      <svg viewBox="0 0 24 24" class="mb-3 ml-auto size-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M6 6l12 12M18 8v10H8" />
      </svg>
      <p class="font-display text-[clamp(1.25rem,2.4vw,2rem)] font-medium leading-[1.1] tracking-[-0.02em]">
        Desenvolvedor<br />full stack
      </p>
    </div>
  </div>

  <!-- Nome correndo em letra gigante, na frente da foto -->
  <div class="absolute inset-x-0 bottom-[7svh] select-none sm:bottom-[9svh]" aria-hidden="true" data-hero-name>
    <div class="flex w-max whitespace-nowrap will-change-transform" data-marquee>
      {
        [0, 1].map((copy) => (
          <div class="flex shrink-0 items-center" data-marquee-copy={copy}>
            {separators.map((color) => (
              <span class="flex items-center font-display text-[clamp(5.5rem,17vw,16rem)] font-semibold leading-none tracking-[-0.045em]">
                <span class="pl-[0.12em]">Marcos Gabriel</span>
                <span class="mx-[0.28em] inline-block size-[0.16em] translate-y-[0.06em]" style={`background:${color}`} />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
