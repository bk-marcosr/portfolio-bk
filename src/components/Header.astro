---
import { profile } from '../data/profile';
import { url } from '../lib/url';

const home = url('/');
const links = [
  { href: `${home}#projetos`, label: 'Projetos' },
  { href: `${home}#experiencia`, label: 'Experiência' },
  { href: `${home}#stack`, label: 'Stack' },
  { href: `${home}#contato`, label: 'Contato' },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
    <a href={home} class="flex items-baseline gap-0.5 text-[15px] font-semibold tracking-tight text-fg">
      marcos<span class="font-mono text-[13px] font-normal text-subtle">.dev</span>
    </a>

    <nav aria-label="Principal" class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            class:list={[
              'rounded-md px-2 py-1.5 text-[13px] text-muted transition-colors hover:text-fg',
              i < links.length - 1 && 'hidden sm:inline-block',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 inline-flex items-center gap-1.5 rounded-md border border-line px-2.5 py-1.5 text-[13px] text-muted transition-colors hover:border-line-strong hover:text-fg"
      >
        <svg viewBox="0 0 16 16" class="size-3.5" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        GitHub
      </a>
    </nav>
  </div>
</header>
