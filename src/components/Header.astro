---
import { profile } from '../data/profile';
import { url } from '../lib/url';

const home = url('/');
---

<header class="fixed inset-x-0 top-0 z-40 transition-[transform,background-color] duration-300 ease-out" data-header>
  <div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-5 sm:px-10">
    <a href={home} class="font-display text-[15px] font-semibold tracking-tight text-paper">{profile.name}</a>
    <nav aria-label="Principal" class="flex items-center gap-5 text-[14px] text-paper sm:gap-8">
      <a href={`${home}#projetos`} class="hidden opacity-70 transition-opacity hover:opacity-100 sm:inline">Projetos</a>
      <a href={`${home}#trajetoria`} class="hidden opacity-70 transition-opacity hover:opacity-100 sm:inline">Trajetória</a>
      <a href={`${home}#contato`} class="opacity-70 transition-opacity hover:opacity-100">Contato</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="opacity-70 transition-opacity hover:opacity-100">GitHub ↗</a>
    </nav>
  </div>
</header>
